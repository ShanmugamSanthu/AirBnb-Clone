<% layout('base_ejs/boilerplate') -%>
    <h2>Listing Details</h2>
    <h4>Author: <%= listingData.publisher.username %></h4>
    <h4><%=listingData.Title%></h4>
    <p><%=listingData.Description%></p>
    <img src=<%=listingData.Image%> alt="Listing Image" width=500px height=500px>
    <p>Price: ₹<%=listingData.Price.toLocaleString("en-IN")%> for 24 Hours</p>
    <p>Location: <u><%=listingData.Location%></u></p>
    <p>Country: <u><%=listingData.Country%></u></p>
    <br><br>
            <form action="/listing/edit/<%= listingData._id %>" method="get">

          <button>Edit Listing</button>
        </form>
    <form action="/listing/delete/<%=listingData._id%>?_method=DELETE" method="post"> 
      <br><br>
      <Button>Delete Listing</Button>
    </form>
    <hr>
      <a href="/review/new/<%=listingData._id%>" >Add a review about this place</a>
    <br>
    <%for(const el of reviewData){%>
      Posted By: <%=el.author.username%>
      <br>
      Comment: <%= el.listingComment  %>  
      <br>
      Rating: <%= el.listingRating %> Stars
      <br>
      Created at:<%=el.createdAt.toLocaleString()   %>
      <form action="/review/delete/<%= el._id %>/<%=listingData._id%>?_method=DELETE" method="post">
        <button>Delete review</button>
      </form>
      <br>  
      <% } %>
    <a href="/">Home</a>


