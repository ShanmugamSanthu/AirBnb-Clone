<% layout('base_ejs/boilerplate') -%>
    <h2>Listing Details</h2>
    <h4><%=userData.Title%></h4>
    <p><%=userData.Description%></p>
    <img src=<%=userData.Image%> alt="Listing Image" width=500px height=500px>
    <p>Price: ₹<%=userData.Price.toLocaleString("en-IN")%> for 24 Hours</p>
    <p>Location: <u><%=userData.Location%></u></p>
    <p>Country: <u><%=userData.Country%></u></p>
    <form action="/listing/delete/<%=userData._id%>?_method=DELETE" method="post">
      <br><br>
      <Button>Delete Listing</Button>
    </form>
    <a href="/">Home</a>
