<%layout("base_ejs/boilerplate")-%>
<p id="warningForm"></p>
<% if (error && error.length > 0) { %>
  <p><%= error[0] %></p>
<% } %>
<form action="/user/login" method="post" class="loginForm">
  Enter email ID:
  <input type="email" placeholder="Enter email ID" name="userEmail" required />
  <br /><br />
  Enter username:
  <input
    type="text"
    name="username"
    placeholder="Enter a username"
    minlength="2"
    required
  />
  <br /><br />
  Enter a password:
  <input
    type="text"
    name="password"
    placeholder="Enter password"
    minlength="5"
    required
  />
  <br /><br />
  <button>Login</button>
</form>
<br />
<a href="/user/signuppage">If you dont have a account signup here</a>
