<% layout('base_ejs/boilerplate') -%>

<h2>Add a new listing</h2>

<% if (error) { %>
    <p><%= error.details[0].message %></p>
<% } %>
<p id="error"></p>
<form action="/listing/new/add" method="post" class="newListing" >
  <input type="text" name="listing[Title]" placeholder="Enter Property Title" / >
  <br /><br />
  <textarea name="listing[Description]" >Add description</textarea>
  <br /><br />
  <input type="number" name="listing[Price]" placeholder="Mention price"  />

  <br /><br />
  <input type="text" name="listing[Location]" placeholder="Enter destination/location"  />
 
  <br /><br />
  <input type="text" name="listing[Country]" placeholder="Enter country name"  />

  <br /><br />
  <input type="url" name="listing[Image]" placeholder="Enter image URL/link" />
  <br /><br />
  <button type="submit">Add Listing</button>
</form>

<br />
<a href="/">Home</a>
