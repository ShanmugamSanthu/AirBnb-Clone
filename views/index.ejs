<% layout('base_ejs/boilerplate') -%>
    <h1>All Listings</h1>
    <ul>
    <%for( let el of userData){%>
        <a href="/listing/<%= el._id %>" ><li><%= el.Title %></li></a>
        <img src="<%= el.Image %>" alt="Listing Image" width=100px height=100px>
        <li><%= el.Description %></li>

        <hr>
    <%}%>
    </ul>
    <a href="/listing/new">Add a new Listings</a>
    <br><br>
    <form action="/user/logout" method="post">
        <button>logout</button>
    </form>
  
