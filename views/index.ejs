<% layout('base_ejs/boilerplate') -%>
    <h1>All Listings</h1>
    <ul>
    <%for( let el of userData){%>
        <a href="/listings/<%= el._id %>" ><li><%= el.Title %></li></a>
        <li><%= el.Description %></li>
        <form action="/listings/edit/<%= el._id %>" method="get">

          <button>Edit Listing</button>
        </form>
        <hr>
    <%}%>
    </ul>
    <a href="/listings/new">Add a new Listings</a>
  
