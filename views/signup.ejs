<%layout("base_ejs/boilerplate")-%>
<p id="warningForm"></p>
<form action="/user/signup" method="post" class="signupForm">
  Enter email ID:
  <input
    type="email"
    name="user[userEmail]"
    placeholder="Enter a valid email ID"
    required
  />
  <br /><br />
  Enter a password:
  <input
    type="text"
    name="user[userPassword]"
    placeholder="Enter password"
    minlength="5"
    required
  />
  <br /><br />
  Enter username:
  <input
    type="text"
    name="user[userName]"
    placeholder="Enter a username"
    minlength="2"
    required
  />
  <br /><br />
  <button>Signup</button>
</form>
<br />
<a href="/user/loginpage">If you already have a account login here</a>
