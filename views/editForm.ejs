<% layout('base_ejs/boilerplate') -%>
<h2>Edit listing Details</h2>
<p id="error"></p>
<% if (error) { %>
    <p><%= error.details[0].message %></p>
<% } %>
<form
  action="/listing/edit/update?_method=PATCH"
  method="post"
  class="newListing"
>
  <input
    type="text"
    name="listing[Title]"
    value="<%= listingData.Title%>"
    
  />

  <br /><br />
  <textarea name="listing[Description]" type="text" >
<%= listingData.Description%></textarea
  >
  
  <br /><br />
  <input
    type="number"
    name="listing[Price]"
    value="<%= listingData.Price%>"
    
  />
 
  <br /><br />
  <input
    type="text"
    name="listing[Location]"
    value="<%= listingData.Location%>"
  
  <br /><br />
  <input
    type="text"
    name="listing[Country]"
    value="<%= listingData.Country%>"
    
  />

  <br /><br />
  <input type="url" name="listing[Image]" value="<%= listingData.Image%>" />
  <br /><br />
  <input type="hidden" name="listing[ID]" value="<%= listingData._id%>" />
  <button type="submit">Save changes</button>
</form>

<a href="/">Home</a>
